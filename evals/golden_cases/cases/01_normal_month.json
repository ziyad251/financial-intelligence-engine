{
  "id": "01_normal_month",
  "title": "Normal month: revenue, COGS, margins, opex by category, operating and net income",
  "fixture": "normal_month",
  "config": {
    "company_name": "Golden Test Co",
    "income_statement": {
      "account_classes": {"non_operating": ["Interest Expense"]},
      "opex_rollups": [
        {"name": "People", "match": ["> Salaries$"]},
        {"name": "Facilities", "match": ["> Rent$"]},
        {"name": "Marketing", "match": ["> Advertising$"]},
        {"name": "Technology", "match": ["> Software$"]},
        {"name": "Interest (non-operating)", "match": ["> Interest Expense$"]}
      ]
    }
  },
  "steps": [
    {
      "exit_code": 0,
      "checks": [
        {"type": "status", "value": "pass"},
        {"type": "issue_codes", "severity": "error", "equals": []},
        {"type": "issue_codes", "severity": "warning", "equals": []},
        {"type": "files", "equals": ["analysis.json", "brief.md", "last_run.json"]},
        {"type": "fixture_sha256", "path": "source.sha256"},
        {"type": "equals", "path": "source.workbook", "value": "01_normal_month.xlsx"},
        {"type": "equals", "path": "periods.analysis_period", "value": "2026-03"},
        {"type": "equals", "path": "company_check.result", "in": "last_run", "value": "matched_workbook_title"},

        {"type": "approx", "path": "analysis_period.metrics[metric=revenue].value", "value": 15000, "calc": "Product Sales 12,000 + Service Revenue 3,000"},
        {"type": "approx", "path": "analysis_period.metrics[metric=cogs].value", "value": 5400, "calc": "Materials 4,800 + Freight 600"},
        {"type": "approx", "path": "analysis_period.metrics[metric=gross_profit].value", "value": 9600, "calc": "15,000 - 5,400"},
        {"type": "approx", "path": "analysis_period.metrics[metric=gross_margin].value", "value": 64.00, "calc": "9,600 / 15,000 = 64.00%"},
        {"type": "approx", "path": "analysis_period.metrics[metric=opex_total].value", "value": 4850, "calc": "3,000 + 1,000 + 500 + 250 + 100"},
        {"type": "approx", "path": "analysis_period.metrics[metric=operating_income].value", "value": 4750, "calc": "9,600 - 4,850"},
        {"type": "approx", "path": "analysis_period.metrics[metric=net_income].value", "value": 4750, "calc": "no Other Income/Expense sections, so equal to operating income"},
        {"type": "approx", "path": "analysis_period.metrics[metric=operating_margin].value", "value": 31.67, "calc": "4,750 / 15,000 = 31.666...%"},
        {"type": "approx", "path": "analysis_period.metrics[metric=core_opex].value", "value": 4750, "calc": "4,850 - Interest Expense 100 (configured non-operating)"},
        {"type": "approx", "path": "analysis_period.metrics[metric=core_operating_income].value", "value": 4850, "calc": "9,600 - 4,750"},
        {"type": "approx", "path": "analysis_period.metrics[metric=core_operating_margin].value", "value": 32.33, "calc": "4,850 / 15,000 = 32.333...%"},
        {"type": "approx", "path": "analysis_period.metrics[metric=opex_to_revenue].value", "value": 32.33, "calc": "4,850 / 15,000 = 32.333...%"},

        {"type": "approx", "path": "analysis_period.metrics[metric=revenue].mom.abs_change", "value": 1500, "calc": "15,000 - Feb 13,500 (11,000 + 2,500)"},
        {"type": "approx", "path": "analysis_period.metrics[metric=revenue].mom.pct_change", "value": 11.11, "calc": "1,500 / 13,500 = 11.111...%"},
        {"type": "approx", "path": "analysis_period.metrics[metric=gross_margin].mom.pp_change", "value": 0.67, "calc": "64.000% - Feb 8,550/13,500 = 63.333% -> 0.667 pp"},
        {"type": "approx", "path": "analysis_period.metrics[metric=revenue].ytd", "value": 40500, "calc": "Jan 12,000 + Feb 13,500 + Mar 15,000"},
        {"type": "equals", "path": "analysis_period.metrics[metric=revenue].ttm", "value": null, "why": "only 3 months of data"},
        {"type": "equals", "path": "analysis_period.metrics[metric=revenue].ttm_note", "value": "insufficient_history"},

        {"type": "approx", "path": "income_statement.monthly.revenue.values.2026-02", "value": 13500, "calc": "11,000 + 2,500"},
        {"type": "approx", "path": "income_statement.monthly.gross_margin.values.2026-02", "value": 63.33, "calc": "(13,500 - 4,950) / 13,500 = 63.333...%"},
        {"type": "approx", "path": "income_statement.monthly.operating_income.values.2026-01", "value": 2800, "calc": "(12,000 - 4,500) - (3,000 + 1,000 + 400 + 200 + 100)"},

        {"type": "equals", "path": "income_statement.opex_categories[name=People].accounts", "value": ["Salaries"]},
        {"type": "approx", "path": "income_statement.opex_categories[name=People].values.2026-03", "value": 3000, "calc": "Salaries"},
        {"type": "approx", "path": "income_statement.opex_categories[name=Facilities].values.2026-03", "value": 1000, "calc": "Rent"},
        {"type": "approx", "path": "income_statement.opex_categories[name=Marketing].values.2026-03", "value": 500, "calc": "Advertising"},
        {"type": "approx", "path": "income_statement.opex_categories[name=Technology].values.2026-03", "value": 250, "calc": "Software"},
        {"type": "approx", "path": "income_statement.opex_categories[name=Interest (non-operating)].values.2026-03", "value": 100, "calc": "Interest Expense"},
        {"type": "absent", "path": "income_statement.opex_categories[name=Other operating expenses]", "why": "every account is categorised"},

        {"type": "equals", "path": "validation.checks[check=derived:gross_profit].status", "value": "pass"},
        {"type": "equals", "path": "validation.checks[check=derived:net_income].status", "value": "pass"},
        {"type": "equals", "path": "validation.checks[check=subtotal:Income Statement:Operating Expenses].status", "value": "pass"}
      ]
    }
  ]
}

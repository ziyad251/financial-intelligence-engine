# --- Secrets & tokens (must never be committed) ---
# QuickBooks credentials live outside the repo (%USERPROFILE%\.secrets\qbo\).
# These patterns are a backstop in case one is ever created here by mistake.
.env
.env.*
*.env
!.env.example
tokens.json
*.token
*.pem
*.key
secrets/
.secrets/

# --- Vendored third-party code (cloned + built locally at a pinned commit) ---
vendor/

# --- Node ---
node_modules/
dist/
npm-debug.log*

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- Claude Code per-user settings (shared settings.json IS committed) ---
.claude/settings.local.json

# --- Local captures that may contain QuickBooks data ---
capture-*.txt
qbo-output/

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# --- Analysis outputs (contain client financial figures) ---
out/

# --- Supplied / client financial data and third-party documents (never committed) ---
data/
docs/*.pdf

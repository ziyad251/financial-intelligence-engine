{
  "id": "04_duplicate_period",
  "title": "Duplicate reporting period (two 'Mar 2026' columns): error, exit 2, failed outputs only",
  "fixture": "duplicate_period",
  "config": null,
  "steps": [
    {
      "exit_code": 2,
      "trace_exit": 1,
      "checks": [
        {"type": "status", "value": "fail"},
        {"type": "issue_codes", "severity": "error", "equals": ["duplicate_period"]},
        {"type": "issue_codes", "severity": "warning", "equals": ["ignored_column"]},
        {"type": "issue", "match": {"code": "duplicate_period", "severity": "error", "period": "2026-03"},
         "message_contains": ["Column G repeats period Mar 2026", "only column F is used"]},
        {"type": "issue", "match": {"code": "ignored_column", "severity": "warning"}, "details": {"column": "G"}},
        {"type": "equals", "path": "periods.available", "value": ["2026-01", "2026-02", "2026-03"]},
        {"type": "equals", "path": "periods.missing_periods", "value": [], "why": "a duplicate is not a gap: no missing month"},
        {"type": "approx", "path": "income_statement.monthly.revenue.values.2026-03", "value": 1200,
         "calc": "first 'Mar 2026' column (F) only; 1,200 + 9,999 = 11,199 would mean the duplicate was summed"},

        {"type": "files", "equals": ["analysis.failed.json", "brief.failed.md", "last_run.json"]},
        {"type": "file_contains", "file": "brief.failed.md", "text": ["**Status: FAIL**", "Do not write commentary", "duplicate_period"]},
        {"type": "equals", "in": "last_run", "path": "status", "value": "fail"},
        {"type": "equals", "in": "last_run", "path": "analysis_json", "value": "analysis.failed.json"}
      ]
    }
  ]
}
